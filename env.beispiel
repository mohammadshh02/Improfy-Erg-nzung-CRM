# Vorlage für improfy_os/.env – diese Datei hier enthält keine echten Zugangsdaten
# und liegt deshalb im Repo. Die echte .env ist in .gitignore und bleibt lokal.
#
#   cp env.beispiel .env      und dann die Werte eintragen

# --- Anmeldung -------------------------------------------------------------
# Ohne Passwort läuft das OS nur auf 127.0.0.1 und fragt niemanden nach Anmeldung.
# Mit Passwort lauscht es im Netz. Im Büro also setzen.
IMPROFY_OS_PASSWORT=
IMPROFY_OS_SECRET=

# --- CRM crm.improfy.de (lesend) -------------------------------------------
# Sobald beides gesetzt ist, liest das OS Kunden und Nutzer aus dem CRM statt
# aus Exporten. Es wird ausschließlich gelesen, nie geschrieben.
# Nötig ist ein Lesezugang (Schnittstelle oder Datenbankbenutzer mit SELECT).
CRM_BASIS=
CRM_TOKEN=
CRM_STANDORT=Köln
# Falls die Pfade im CRM anders heißen:
CRM_PFAD_KUNDEN=/api/kunden
CRM_PFAD_NUTZER=/api/nutzer

# --- Figma (Designvorlagen ansehen, optional) ------------------------------
# Das OS meldet sich nicht bei Figma an. Es braucht ein persönliches Zugriffstoken:
# Figma öffnen → oben rechts aufs Konto → Settings → Security → Personal access tokens
# → "Generate new token", Leserecht genügt. Das Token hier einsetzen.
FIGMA_TOKEN=
# Datei-Schlüssel der Design-Datei (steht in der Figma-URL nach /file/ oder /design/)
FIGMA_DATEI=

# --- Schnittstellen des OS (lesend) ----------------------------------------
# Solange kein IMPROFY_OS_PASSWORT gesetzt ist, lauscht das OS nur auf 127.0.0.1;
# dann braucht die Schnittstelle keinen Schlüssel. Sobald das OS im Netz steht,
# ist OS_API_TOKEN Pflicht: als "Authorization: Bearer <token>" oder "?token=".
OS_API_TOKEN=
# Erlaubt dem CRM, die Schnittstelle auch aus dem Browser heraus aufzurufen.
OS_API_HERKUNFT=https://crm.improfy.de

# --- HubSpot (läuft aus) ---------------------------------------------------
# Solange das CRM die Kölner Kunden nicht führt, bleibt HubSpot zweite Quelle.
# Ohne Token liest das OS die CSV-Exporte aus exporte/.
HUBSPOT_TOKEN=

# --- Taskforce: ImmoScout24-Suchauftragsmails ------------------------------
# Das OS meldet sich NICHT bei ImmoScout24 an. Es liest nur das Postfach, in dem
# die Alarm-Mails der Suchaufträge ankommen.
#
# Für das Improfy-Postfach bei IONOS (coach@improfy.de):
#   TF_IMAP_HOST=imap.ionos.de     (Port 993 mit SSL, das nimmt das OS von selbst)
#   TF_IMAP_USER=coach@improfy.de  (die volle Adresse, nicht nur "coach")
#   TF_IMAP_PASSWORT=<Passwort des Postfachs>
# Bei Gmail statt dessen imap.gmail.com und ein App-Passwort, nicht das Kennwort.
TF_IMAP_HOST=
TF_IMAP_USER=
TF_IMAP_PASSWORT=
# Eigener Ordner, falls eine Regel die IS24-Mails dorthin sortiert:
TF_IMAP_ORDNER=INBOX

# --- Taskforce: Alarm in Google Chat ---------------------------------------
# Webhook des Taskforce-Raums (Chat-Raum → Apps & Integrationen → Webhooks)
TF_CHAT_WEBHOOK=
TF_OS_URL=http://localhost:8100

# --- Taskforce: zusätzliche Jobportale (optional) --------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# Zentrale WhatsApp-Nummer (nur fuer den Versand ueber Kommo).
# Auf improfy.de/kontakt stehen drei - die richtige hier eintragen.
WHATSAPP_ZENTRALE=+49 178 3079654
# Kanalkennung des WhatsApp-Kanals in Kommo
KOMMO_KANAL=
